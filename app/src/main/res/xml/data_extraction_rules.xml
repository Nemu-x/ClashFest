<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="sharedpref"
            path="." />
        <exclude
            domain="sharedpref"
            path="companion_controller.xml" />
        <include
            domain="database"
            path="." />
        <exclude
            domain="database"
            path="profiles" />
        <exclude
            domain="database"
            path="profiles-shm" />
        <exclude
            domain="database"
            path="profiles-wal" />
        <!-- imported/ and pending/ are intentionally NOT extracted: a profile may hold an age-encrypted
             body or secret key that must not leave the device. Only override.json is included
             (whitelist mode — anything not listed is skipped). -->
        <include
            domain="file"
            path="clash/override.json" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="sharedpref"
            path="." />
        <exclude
            domain="sharedpref"
            path="companion_controller.xml" />
        <include
            domain="database"
            path="." />
        <exclude
            domain="database"
            path="profiles" />
        <exclude
            domain="database"
            path="profiles-shm" />
        <exclude
            domain="database"
            path="profiles-wal" />
        <!-- imported/ and pending/ are intentionally NOT extracted: a profile may hold an age-encrypted
             body or secret key that must not leave the device. Only override.json is included
             (whitelist mode — anything not listed is skipped). -->
        <include
            domain="file"
            path="clash/override.json" />
    </device-transfer>
</data-extraction-rules>
