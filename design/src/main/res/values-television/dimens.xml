<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TV: a 1080p panel is ~960x540dp. Landscape.kt caps content at max(height, this), which
         left a 540dp phone column in the middle of the TV; let content use most of the width
         while keeping a ~30dp overscan-safe margin on each side. -->
    <dimen name="surface_landscape_min_width">900dp</dimen>

    <!-- Node rows in the TV side panel are one line (name + protocol chips, see
         ProxyPickerSheet.inlineNodeRowMeta), so they can be compact and still read from the sofa. -->
    <dimen name="proxy_node_row_min_height">46dp</dimen>
    <dimen name="proxy_node_row_padding_vertical">5dp</dimen>
    <dimen name="proxy_group_segment_min_height">30dp</dimen>

    <!-- Keeps the empty-state focus ring inside the 16dp content column, like the rule rows. -->
    <dimen name="rules_hub_empty_margin_horizontal">16dp</dimen>
    <!-- Section headers share that inset (one ring width down the column); their text keeps a
         small inner gap from the ring instead of a second 16dp. -->
    <dimen name="rules_hub_section_padding_horizontal">8dp</dimen>
    <!-- The header's text sits in the middle of its focus ring (16dp over 6dp put it at the ring's
         bottom); the space above moves outside the row. -->
    <dimen name="rules_hub_section_padding_top">10dp</dimen>
    <dimen name="rules_hub_section_padding_bottom">10dp</dimen>
    <dimen name="rules_hub_section_margin_top">6dp</dimen>
    <!-- Keeps the empty-state row's ring off the "Add rule" button right below it. -->
    <dimen name="rules_hub_empty_margin_bottom">12dp</dimen>

    <!-- The nav is a rail on the left on TV (MainDesignTv.applyTvNavigationRail), so the tab pages
         no longer reserve room for a bar along the bottom; only the overscan-safe margin under the
         last row (tv_focus_edge_margin). -->
    <dimen name="main_bottom_nav_reserved_space">@dimen/tv_focus_edge_margin</dimen>
</resources>
