<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/proxy_row_main_hit"
    android:stateListAnimator="@animator/focus_scale"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_proxy_node_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingVertical="4dp">

    <!-- Selection is now shown by the accent outline (bg_proxy_node_row) + check, so the left
         rail is retired. Kept as a 0-width view because selection tracking reads its visibility. -->
    <View
        android:id="@+id/selected_bar"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_proxy_node_rail"
        android:visibility="invisible" />

    <FrameLayout
        android:id="@+id/proxy_flag_card"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="12dp"
        android:visibility="gone">

        <com.google.android.material.imageview.ShapeableImageView
            android:importantForAccessibility="no"
            android:id="@+id/proxy_flag_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurfaceContainerHigh"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle" />

        <TextView
            android:id="@+id/proxy_flag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_flag_circle"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="US" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/proxy_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.BodyLarge"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            tools:text="AuraVPN | Нидерланды | VLESS XHTTP" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/proxy_protocol_capsule"
            android:background="@drawable/bg_proto_capsule"
            android:clipToOutline="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:importantForAccessibility="no"
            app:chipSpacingHorizontal="1dp"
            app:chipSpacingVertical="1dp"
            app:singleLine="false">

            <TextView
                android:id="@+id/proxy_type_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_proto_segment"
                android:fontFamily="@font/manrope_semibold"
                android:letterSpacing="0"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textAllCaps="true"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="VLESS"
                tools:textColor="@color/proto_xhttp"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/proxy_transport_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_proto_segment"
                android:fontFamily="@font/manrope_semibold"
                android:letterSpacing="0"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textAllCaps="true"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="XHTTP"
                tools:textColor="@color/proto_xhttp"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/proxy_reality_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_proto_segment"
                android:fontFamily="@font/manrope_semibold"
                android:letterSpacing="0"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textAllCaps="true"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="REALITY"
                tools:textColor="@color/proto_reality"
                tools:visibility="visible" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/proxy_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:text="vless · 443"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Tap target (48dp): measures just this node (ProfileAdapter.onPingNode). The borderless
         ripple lives on this wrapper; the tinted pill inside carries the level colour
         (applyDelayStyle). Focusable so a TV d-pad can reach it too. -->
    <FrameLayout
        android:id="@+id/latency_capsule"
        android:stateListAnimator="@animator/focus_scale"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/proxy_ping_node"
        android:focusable="true"
        android:minWidth="56dp"
        android:minHeight="48dp">

        <LinearLayout
            android:id="@+id/latency_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_delay_pill"
            android:gravity="center_vertical"
            android:minHeight="28dp"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <View
                android:id="@+id/latency_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/dot_circle"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/proxy_delay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/manrope_semibold"
                android:gravity="center"
                android:maxWidth="64dp"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.LabelMedium"
                android:textStyle="bold"
                app:fontFamily="@font/manrope_semibold"
                tools:text="47ms" />
        </LinearLayout>
    </FrameLayout>

    <ImageView
        android:id="@+id/selected_check"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_baseline_check"
        android:visibility="invisible"
        app:tint="?attr/colorPrimary"
        tools:visibility="visible" />
</LinearLayout>
