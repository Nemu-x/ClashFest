<?xml version="1.0" ?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="self"
            type="com.github.kr328.clash.design.RoutingHubDesign"/>
        <import type="com.github.kr328.clash.design.util.BindingExpressions"/>
    </data>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home_canvas"
        android:paddingStart="@{self.surface.insets.start}"
        android:paddingEnd="@{self.surface.insets.end}">
        <com.github.kr328.clash.design.view.ObservableScrollView
            android:id="@+id/scroll_root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            app:marginTopPx="@{self.surface.insets.top}"
            android:paddingBottom="@{self.surface.insets.bottom}">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="24dp">
                <include
                    android:id="@+id/header"
                    layout="@layout/include_screen_header"/>
                <com.google.android.material.card.MaterialCardView
                    style="@style/AppCard.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/routing_active_profile"
                            android:textAppearance="@style/TextAppearance.App.LabelLarge"
                            android:textColor="?attr/colorOnSurfaceVariant"/>
                        <TextView
                            android:id="@+id/routing_profile"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/routing_no_subscription"
                            android:textAppearance="@style/TextAppearance.App.TitleMedium"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginTop="8dp"/>
                        <TextView
                            android:id="@+id/routing_counts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/routing_open_to_load"
                            android:textAppearance="@style/TextAppearance.App.BodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_marginTop="8dp"
                            android:accessibilityLiveRegion="polite"/>
                        <LinearLayout
                            android:id="@+id/routing_loading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical"
                            android:importantForAccessibility="no"
                            android:visibility="gone">
                            <View
                                android:layout_width="180dp"
                                android:layout_height="12dp"
                                android:background="@drawable/bg_m3_status_chip_neutral"/>
                            <View
                                android:layout_width="120dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_m3_status_chip_neutral"/>
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/routing_add"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:minHeight="48dp"
                            android:text="@string/rules_hub_add_rule"
                            android:enabled="false"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/routing_rules_section"
                    android:textAppearance="@style/TextAppearance.App.LabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"
                    android:paddingStart="4dp"/>
                <com.google.android.material.card.MaterialCardView
                    style="@style/AppCard.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:id="@+id/card_rules"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="72dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_baseline_route"
                                android:importantForAccessibility="no"
                                app:tint="?attr/colorOnSurfaceVariant"/>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="16dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/routing_my_rules"
                                    android:textAppearance="@style/TextAppearance.App.BodyLarge"
                                    android:textColor="?attr/colorOnSurface"/>
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/routing_my_rules_summary"
                                    android:textAppearance="@style/TextAppearance.App.BodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:layout_marginTop="4dp"/>
                            </LinearLayout>
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/ic_baseline_chevron_right"
                                android:importantForAccessibility="no"
                                app:tint="?attr/colorOnSurfaceVariant"/>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/card_providers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="72dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_baseline_subscriptions"
                                android:importantForAccessibility="no"
                                app:tint="?attr/colorOnSurfaceVariant"/>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="16dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/routing_providers"
                                    android:textAppearance="@style/TextAppearance.App.BodyLarge"
                                    android:textColor="?attr/colorOnSurface"/>
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/routing_providers_summary"
                                    android:textAppearance="@style/TextAppearance.App.BodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:layout_marginTop="4dp"/>
                            </LinearLayout>
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/ic_baseline_chevron_right"
                                android:importantForAccessibility="no"
                                app:tint="?attr/colorOnSurfaceVariant"/>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/card_effective"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="72dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_baseline_route"
                                android:importantForAccessibility="no"
                                app:tint="?attr/colorOnSurfaceVariant"/>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="16dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/routing_effective"
                                    android:textAppearance="@style/TextAppearance.App.BodyLarge"
                                    android:textColor="?attr/colorOnSurface"/>
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/routing_effective_summary"
                                    android:textAppearance="@style/TextAppearance.App.BodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:layout_marginTop="4dp"/>
                            </LinearLayout>
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/ic_baseline_chevron_right"
                                android:importantForAccessibility="no"
                                app:tint="?attr/colorOnSurfaceVariant"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/routing_order_hint"
                    android:textAppearance="@style/TextAppearance.App.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="4dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_connection_section"
                    android:textAppearance="@style/TextAppearance.App.LabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"
                    android:paddingStart="4dp"/>
                <com.google.android.material.card.MaterialCardView
                    style="@style/AppCard.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:id="@+id/card_per_app"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="72dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_baseline_subscriptions"
                                android:importantForAccessibility="no"
                                app:tint="?attr/colorOnSurfaceVariant"/>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="16dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/access_control_packages"
                                    android:textAppearance="@style/TextAppearance.App.BodyLarge"
                                    android:textColor="?attr/colorOnSurface"/>
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/routing_hub_per_app_summary"
                                    android:textAppearance="@style/TextAppearance.App.BodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:layout_marginTop="4dp"/>
                            </LinearLayout>
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/ic_baseline_chevron_right"
                                android:importantForAccessibility="no"
                                app:tint="?attr/colorOnSurfaceVariant"/>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/card_proxy_chain"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="72dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_baseline_swap_horiz"
                                android:importantForAccessibility="no"
                                app:tint="?attr/colorOnSurfaceVariant"/>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="16dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/proxy_chain_title"
                                    android:textAppearance="@style/TextAppearance.App.BodyLarge"
                                    android:textColor="?attr/colorOnSurface"/>
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/routing_chain_summary"
                                    android:textAppearance="@style/TextAppearance.App.BodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:layout_marginTop="4dp"/>
                            </LinearLayout>
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/ic_baseline_chevron_right"
                                android:importantForAccessibility="no"
                                app:tint="?attr/colorOnSurfaceVariant"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.github.kr328.clash.design.view.ObservableScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
