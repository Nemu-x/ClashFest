+// disabledLocalStorage stands in for `service: local` while AllowLocalService
+// is off (Mikan Android patch 0003). It creates nothing and refuses every
+// operation, so the proxy loads but cannot be used.
+type disabledLocalStorage struct{}
+
+func (disabledLocalStorage) Put(context.Context, string, []byte) error {
+	return ErrLocalServiceDisabled
+}
+func (disabledLocalStorage) Get(context.Context, string) ([]byte, error) {
+	return nil, ErrLocalServiceDisabled
+}
+func (disabledLocalStorage) Delete(context.Context, string) error {
+	return ErrLocalServiceDisabled
+}
+func (disabledLocalStorage) List(context.Context, string) ([]Entry, error) {
+	return nil, ErrLocalServiceDisabled
+}
+func (disabledLocalStorage) Close() error { return nil }
