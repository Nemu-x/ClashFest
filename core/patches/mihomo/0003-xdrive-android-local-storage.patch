@@ -0,0 +1,54 @@
+package xdrive
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestLocalServiceGate(t *testing.T) {
+	saved := AllowLocalService
+	t.Cleanup(func() { AllowLocalService = saved })
+
+	AllowLocalService = true
+	allowed := Config{Service: "local", RemoteFolder: filepath.Join(t.TempDir(), "allowed")}
+	if err := allowed.Validate(); err != nil {
+		t.Fatalf("local allowed: %v", err)
+	}
+	if _, err := newStorage(allowed, nil); err != nil {
+		t.Fatalf("local storage allowed: %v", err)
+	}
+	if _, err := os.Stat(allowed.RemoteFolder); err != nil {
+		t.Fatalf("allowed local storage must create its folder: %v", err)
+	}
+
+	AllowLocalService = false
+	folder := filepath.Join(t.TempDir(), "refused")
+	cfg := Config{Service: "local", RemoteFolder: folder}
+	if err := cfg.Validate(); err != nil {
+		t.Fatalf("a refused local node must still validate: %v", err)
+	}
+	client, err := NewClient(cfg, nil)
+	if err != nil {
+		t.Fatalf("client for a refused local node: %v", err)
+	}
+	if _, err := client.Dial(context.Background()); !errors.Is(err, ErrLocalServiceDisabled) {
+		t.Fatalf("dial through a refused local node: got %v", err)
+	}
+	if err := client.Close(); err != nil {
+		t.Fatalf("close: %v", err)
+	}
+	if _, err := Listen(cfg, nil); !errors.Is(err, ErrLocalServiceDisabled) {
+		t.Fatalf("listen on a refused local node: got %v", err)
+	}
+	if _, err := os.Stat(folder); !os.IsNotExist(err) {
+		t.Fatalf("a refused local node touched the filesystem: %v", err)
+	}
+
+	cloud := Config{Service: "google-drive", RemoteFolder: "id", Secrets: []string{"a", "b", "c"}}
+	if err := cloud.Validate(); err != nil {
+		t.Fatalf("google-drive must not be affected: %v", err)
+	}
+}
