+package tls
+
+import (
+	"net"
+
+	"github.com/metacubex/mihomo/log"
+
+	"github.com/metacubex/randv2"
+	utls "github.com/metacubex/utls"
+)
+
+// ClashFest core patch 0026: the Chrome 155 ClientHello as client-fingerprint
+// "chrome155" (and Xray's "hellochrome_155").
+//
+// Xray-core 26.11.9 made hellochrome_155 its default fingerprint
+// (XTLS/Xray-core#7135) and Citrus v1.0.0-beta.3 maps "chrome" to it. The profile
+// comes from refraction-networking/utls 6ebdceb2 (also getmikan/utls a6dee38a),
+// checked there against a capture of Chrome 155.0.8059.40. metacubex/utls stops
+// at Chrome 133 (v1.8.8, and v1.9.0-alpha.1 of mihomo v1.19.34), so the spec is
+// carried here as data and applied through HelloCustom + ApplyPreset; the
+// library itself is not forked or replaced.
+// Adapted from Rerowros/veles component/tls/chrome155.go (GPL-3.0).
+//
+// Compared with Chrome 133 the hello gains a GREASE value and three ML-DSA
+// schemes in signature_algorithms (advertised only: no ML-DSA certificate is
+// ever verified) and the trust_anchors extension (0xca34) with 28 Chrome Root
+// Store IDs. "chrome" keeps mihomo's meaning (Chrome 133): non-vanilla
+// behaviour only when the config asks for it.
+//
+// Delete when mihomo moves to a utls release that ships HelloChrome_155 (then map
+// the names to it).
+
+// HelloChrome155 names the profile. utls does not know the version, so the ID
+// must reach utls only through UClient (uClient) in this package.
+var HelloChrome155 = UClientHelloID{Client: utls.HelloChrome_133.Client, Version: "155"}
+
+const (
+	extensionTrustAnchors uint16 = 0xca34 // draft-ietf-tls-trust-anchor-ids
+
+	sigSchemeMLDSA44 utls.SignatureScheme = 0x0904
+	sigSchemeMLDSA65 utls.SignatureScheme = 0x0905
+	sigSchemeMLDSA87 utls.SignatureScheme = 0x0906
+)
+
+// chrome155TrustAnchorIDs are the Chrome Root Store IDs a fresh Chrome
+// 155.0.8059.40 advertises, in the captured (lexicographic) order.
+var chrome155TrustAnchorIDs = [][]byte{
+	{0x82, 0xdf, 0x13, 0x02, 0x01},
+	{0x82, 0xdf, 0x13, 0x02, 0x06},
+	{0x82, 0xdf, 0x13, 0x02, 0x0d},
+	{0x82, 0xdf, 0x13, 0x02, 0x0e},
+	{0x82, 0xdf, 0x13, 0x02, 0x0f},
+	{0x82, 0xdf, 0x13, 0x02, 0x12},
+	{0x82, 0xdf, 0x13, 0x02, 0x13},
+	{0x82, 0xdf, 0x13, 0x02, 0x14},
+	{0x83, 0x9a, 0x64, 0x8c, 0x9b, 0x2d, 0x01, 0x07},
+	{0x83, 0x9a, 0x64, 0x8c, 0x9b, 0x2d, 0x01, 0x08},
+	{0x83, 0x9a, 0x64, 0x8c, 0x9b, 0x2d, 0x01, 0x09},
+	{0x83, 0x9a, 0x64, 0x8c, 0x9b, 0x2d, 0x01, 0x0a},
+	{0x83, 0x9a, 0x64, 0x8c, 0x9b, 0x2d, 0x01, 0x0b},
+	{0x83, 0x9a, 0x64, 0x8c, 0x9b, 0x2d, 0x01, 0x0c},
+	{0x83, 0x9a, 0x64, 0x8c, 0x9b, 0x2d, 0x01, 0x0d},
+	{0x83, 0x9a, 0x64, 0x8c, 0x9b, 0x2d, 0x01, 0x12},
+	{0x83, 0x9a, 0x64, 0x8c, 0x9b, 0x2d, 0x01, 0x13},
+	{0xd6, 0x79, 0x09, 0x01},
+	{0xd6, 0x79, 0x09, 0x04},
+	{0xd6, 0x79, 0x09, 0x05},
+	{0xd6, 0x79, 0x09, 0x06},
+	{0xd6, 0x79, 0x09, 0x07},
+	{0xd6, 0x79, 0x09, 0x08},
+	{0xd6, 0x79, 0x09, 0x0a},
+	{0xd6, 0x79, 0x09, 0x0b},
+	{0xd6, 0x79, 0x09, 0x0c},
+	{0xd6, 0x79, 0x09, 0x0d},
+	{0xd6, 0x79, 0x09, 0x0f},
+}
+
+// chrome155TrustAnchorsData is the extension_data of trust_anchors: a
+// two-byte list length, then every ID behind its one-byte length.
+func chrome155TrustAnchorsData() []byte {
+	data := []byte{0, 0}
+	for _, id := range chrome155TrustAnchorIDs {
+		data = append(data, byte(len(id)))
+		data = append(data, id...)
+	}
+	listLen := len(data) - 2
+	data[0], data[1] = byte(listLen>>8), byte(listLen)
+	return data
+}
+
+// chrome155Spec returns a fresh spec: utls mutates it per connection.
+func chrome155Spec() *utls.ClientHelloSpec {
+	// utls (v1.8.8, v1.9.0-alpha.1) replaces GREASE placeholders in cipher
+	// suites, groups, key shares and versions but not in signature_algorithms,
+	// so the value is drawn here. BoringSSL draws every GREASE value independently.
+	greaseSigScheme := utls.SignatureScheme(uint16(randv2.IntN(16))*0x1010 + 0x0a0a)
+
+	return &utls.ClientHelloSpec{
+		CipherSuites: []uint16{
+			utls.GREASE_PLACEHOLDER,
+			utls.TLS_AES_128_GCM_SHA256,
+			utls.TLS_AES_256_GCM_SHA384,
+			utls.TLS_CHACHA20_POLY1305_SHA256,
+			utls.TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,
+			utls.TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,
+			utls.TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,
+			utls.TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,
+			utls.TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305,
+			utls.TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305,
+			utls.TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA,
+			utls.TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA,
+			utls.TLS_RSA_WITH_AES_128_GCM_SHA256,
+			utls.TLS_RSA_WITH_AES_256_GCM_SHA384,
+			utls.TLS_RSA_WITH_AES_128_CBC_SHA,
+			utls.TLS_RSA_WITH_AES_256_CBC_SHA,
+		},
+		CompressionMethods: []byte{0x00},
+		Extensions: utls.ShuffleChromeTLSExtensions([]utls.TLSExtension{
+			&utls.UtlsGREASEExtension{},
+			&utls.SNIExtension{},
+			&utls.ExtendedMasterSecretExtension{},
+			&utls.RenegotiationInfoExtension{Renegotiation: utls.RenegotiateOnceAsClient},
+			&utls.SupportedCurvesExtension{Curves: []utls.CurveID{
+				utls.GREASE_PLACEHOLDER,
+				utls.X25519MLKEM768,
+				utls.X25519,
+				utls.CurveP256,
+				utls.CurveP384,
+			}},
+			&utls.SupportedPointsExtension{SupportedPoints: []byte{0x00}},
+			&utls.SessionTicketExtension{},
+			&utls.ALPNExtension{AlpnProtocols: []string{"h2", "http/1.1"}},
+			&utls.StatusRequestExtension{},
+			&utls.SignatureAlgorithmsExtension{SupportedSignatureAlgorithms: []utls.SignatureScheme{
+				greaseSigScheme,
+				sigSchemeMLDSA44,
+				sigSchemeMLDSA65,
+				sigSchemeMLDSA87,
+				utls.ECDSAWithP256AndSHA256,
+				utls.PSSWithSHA256,
+				utls.PKCS1WithSHA256,
+				utls.ECDSAWithP384AndSHA384,
+				utls.PSSWithSHA384,
+				utls.PKCS1WithSHA384,
+				utls.PSSWithSHA512,
+				utls.PKCS1WithSHA512,
+			}},
+			&utls.SCTExtension{},
+			&utls.KeyShareExtension{KeyShares: []utls.KeyShare{
+				{Group: utls.CurveID(utls.GREASE_PLACEHOLDER), Data: []byte{0}},
+				{Group: utls.X25519MLKEM768},
+				{Group: utls.X25519},
+			}},
+			&utls.PSKKeyExchangeModesExtension{Modes: []uint8{utls.PskModeDHE}},
+			&utls.SupportedVersionsExtension{Versions: []uint16{
+				utls.GREASE_PLACEHOLDER,
+				utls.VersionTLS13,
+				utls.VersionTLS12,
+			}},
+			&utls.UtlsCompressCertExtension{Algorithms: []utls.CertCompressionAlgo{
+				utls.CertCompressionBrotli,
+			}},
+			&utls.ApplicationSettingsExtensionNew{SupportedProtocols: []string{"h2"}},
+			&utls.GenericExtension{Id: extensionTrustAnchors, Data: chrome155TrustAnchorsData()},
+			utls.BoringGREASEECH(),
+			&utls.UtlsGREASEExtension{},
+		}),
+	}
+}
+
+// fingerprintSpec is utls.UTLSIdToSpec that also knows HelloChrome155.
+func fingerprintSpec(id UClientHelloID) (utls.ClientHelloSpec, error) {
+	if id == HelloChrome155 {
+		return *chrome155Spec(), nil
+	}
+	return utls.UTLSIdToSpec(id)
+}
+
+// uClient is utls.UClient that also knows HelloChrome155. Every utls client in
+// the core must be created through it (UClient): utls.UClient cannot build a
+// hello for an ID it does not know.
+func uClient(c net.Conn, config *utls.Config, fingerprint UClientHelloID) *UConn {
+	if fingerprint == HelloChrome155 {
+		customConfig := config
+		if config != nil && config.ClientSessionCache != nil && !config.SessionTicketsDisabled && !config.PreferSkipResumptionOnNilExtension {
+			// The spec has no pre_shared_key extension (neither has Chrome's
+			// first hello), and utls panics in BuildHandshakeState when a
+			// HelloCustom client finds a cached TLS 1.3 session for it. The
+			// built-in profiles skip resumption in that case; do the same, on a
+			// copy so the caller's config is left as it was.
+			customConfig = config.Clone()
+			customConfig.PreferSkipResumptionOnNilExtension = true
+		}
+		uConn := utls.UClient(c, customConfig, utls.HelloCustom)
+		if err := uConn.ApplyPreset(chrome155Spec()); err == nil {
+			return uConn
+		} else {
+			// ApplyPreset fails on a config no hello can be built from (no
+			// ServerName and no InsecureSkipVerify, an empty or oversized
+			// NextProtos entry) or a failing random source. Chrome 133 is the
+			// closest hello; a config error then comes back from its
+			// BuildHandshakeState.
+			log.Warnln("chrome155 fingerprint: %v, falling back to chrome 133", err)
+		}
+		fingerprint = utls.HelloChrome_133
+	}
+	return utls.UClient(c, config, fingerprint)
+}
diff --git a/component/tls/chrome155_test.go b/component/tls/chrome155_test.go
new file mode 100644
index 00000000..deb37626
--- /dev/null
+++ b/component/tls/chrome155_test.go
@@ -0,0 +1,476 @@
+package tls
+
+// ClashFest core patch 0026 tests. The capture comparison is adapted from
+// Rerowros/veles component/tls/chrome155_veles_test.go (GPL-3.0).
+//
+// testdata/chrome155_clienthello.hex is the first TLS record of a fresh
+// connection of Google Chrome 155.0.8059.40 to www.example.com, from
+// refraction-networking/utls 6ebdceb2 / getmikan/utls a6dee38a
+// (testdata/chrome155_clienthello.md there; SHA-256 of the handshake
+// 235618e3922e52a71a9f6593a71ec4ca182dab6b3ab4e90a2a1733133e97439a).
+
+import (
+	"bytes"
+	"context"
+	"crypto/ecdh"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/binary"
+	"encoding/hex"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"io"
+	"io/fs"
+	"math/big"
+	"net"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+
+	utls "github.com/metacubex/utls"
+)
+
+type parsedClientHello struct {
+	version      uint16
+	sessionIDLen int
+	cipherSuites []uint16
+	compression  []byte
+	extensionIDs []uint16          // wire order
+	extensions   map[uint16][]byte // extension_data by type
+}
+
+func isGREASE(v uint16) bool {
+	return v>>8 == v&0xff && v&0xf == 0xa
+}
+
+// parseClientHello reads a ClientHello handshake message (with its four-byte
+// header) and replaces every GREASE extension type with 0x0a0a.
+func parseClientHello(t *testing.T, raw []byte) parsedClientHello {
+	t.Helper()
+	if len(raw) < 4 || raw[0] != 1 || int(raw[1])<<16|int(raw[2])<<8|int(raw[3]) != len(raw)-4 {
+		t.Fatalf("not a ClientHello handshake message, %d bytes", len(raw))
+	}
+	b := raw[4:]
+	next := func(n int) []byte {
+		t.Helper()
+		if len(b) < n {
+			t.Fatalf("ClientHello truncated")
+		}
+		out := b[:n]
+		b = b[n:]
+		return out
+	}
+	var hello parsedClientHello
+	hello.version = binary.BigEndian.Uint16(next(2))
+	next(32) // random
+	hello.sessionIDLen = len(next(int(next(1)[0])))
+	suites := next(int(binary.BigEndian.Uint16(next(2))))
+	for i := 0; i+1 < len(suites); i += 2 {
+		hello.cipherSuites = append(hello.cipherSuites, binary.BigEndian.Uint16(suites[i:]))
+	}
+	hello.compression = next(int(next(1)[0]))
+	if extLen := int(binary.BigEndian.Uint16(next(2))); extLen != len(b) {
+		t.Fatalf("extensions length %d, %d bytes left", extLen, len(b))
+	}
+	hello.extensions = map[uint16][]byte{}
+	for len(b) > 0 {
+		id := binary.BigEndian.Uint16(next(2))
+		data := next(int(binary.BigEndian.Uint16(next(2))))
+		if isGREASE(id) {
+			id = 0x0a0a
+		}
+		hello.extensionIDs = append(hello.extensionIDs, id)
+		hello.extensions[id] = data
+	}
+	return hello
+}
+
+// ungrease replaces GREASE values in a list of uint16 that starts at offset.
+func ungrease(data []byte, offset int) []byte {
+	out := bytes.Clone(data)
+	for i := offset; i+1 < len(out); i += 2 {
+		if isGREASE(binary.BigEndian.Uint16(out[i:])) {
+			out[i], out[i+1] = 0x0a, 0x0a
+		}
+	}
+	return out
+}
+
+func ungreaseSuites(suites []uint16) []uint16 {
+	out := append([]uint16(nil), suites...)
+	for i, suite := range out {
+		if isGREASE(suite) {
+			out[i] = 0x0a0a
+		}
+	}
+	return out
+}
+
+func sortedIDs(ids []uint16) []uint16 {
+	out := append([]uint16(nil), ids...)
+	sort.Slice(out, func(i, j int) bool { return out[i] < out[j] })
+	return out
+}
+
+func equalUint16s(a, b []uint16) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// keyShareShape returns "group:length" of every key share, GREASE as 0a0a.
+func keyShareShape(t *testing.T, data []byte) []string {
+	t.Helper()
+	var out []string
+	for b := data[2:]; len(b) > 0; {
+		if len(b) < 4 {
+			t.Fatalf("key_share truncated")
+		}
+		group, n := binary.BigEndian.Uint16(b), int(binary.BigEndian.Uint16(b[2:]))
+		if isGREASE(group) {
+			group = 0x0a0a
+		}
+		out = append(out, hex.EncodeToString([]byte{byte(group >> 8), byte(group)})+":"+hex.EncodeToString([]byte{byte(n >> 8), byte(n)}))
+		b = b[4+n:]
+	}
+	return out
+}
+
+func buildRawClientHello(t *testing.T, name string, serverName string) []byte {
+	t.Helper()
+	id, ok := GetFingerprint(name)
+	if !ok {
+		t.Fatalf("fingerprint %q not found", name)
+	}
+	client, server := net.Pipe()
+	t.Cleanup(func() { client.Close(); server.Close() })
+	uConn := UClient(client, &utls.Config{ServerName: serverName}, id)
+	if err := uConn.BuildHandshakeState(); err != nil {
+		t.Fatalf("BuildHandshakeState(%s): %v", name, err)
+	}
+	return uConn.HandshakeState.Hello.Raw
+}
+
+func TestChrome155MatchesBrowserCapture(t *testing.T) {
+	fixture, err := os.ReadFile("testdata/chrome155_clienthello.hex")
+	if err != nil {
+		t.Fatal(err)
+	}
+	record, err := hex.DecodeString(strings.TrimSpace(string(fixture)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := parseClientHello(t, record[5:]) // skip the TLS record header
+
+	const (
+		extSupportedGroups = 10
+		extSigAlgs         = 13
+		extSupportedVers   = 43
+		extKeyShare        = 51
+		extECH             = 0xfe0d
+	)
+	if _, ok := want.extensions[extensionTrustAnchors]; !ok {
+		t.Fatal("the capture has no trust_anchors extension: wrong fixture")
+	}
+
+	for _, name := range []string{"chrome155", "hellochrome_155", "HelloChrome_155"} {
+		t.Run(name, func(t *testing.T) {
+			// Extension order and GREASE values are random: several hellos.
+			for i := 0; i < 20; i++ {
+				raw := buildRawClientHello(t, name, "www.example.com")
+				got := parseClientHello(t, raw)
+
+				if got.version != want.version || got.sessionIDLen != want.sessionIDLen {
+					t.Fatalf("version %04x, session ID %d bytes; Chrome sends %04x and %d", got.version, got.sessionIDLen, want.version, want.sessionIDLen)
+				}
+				if g, w := ungreaseSuites(got.cipherSuites), ungreaseSuites(want.cipherSuites); !equalUint16s(g, w) {
+					t.Fatalf("cipher suites %04x, Chrome sends %04x", g, w)
+				}
+				if !isGREASE(got.cipherSuites[0]) {
+					t.Fatalf("first cipher suite %04x is not GREASE", got.cipherSuites[0])
+				}
+				if !bytes.Equal(got.compression, want.compression) {
+					t.Fatalf("compression %x, Chrome sends %x", got.compression, want.compression)
+				}
+
+				// Chrome shuffles everything between the two GREASE extensions.
+				n := len(got.extensionIDs)
+				if n != len(want.extensionIDs) || got.extensionIDs[0] != 0x0a0a || got.extensionIDs[n-1] != 0x0a0a {
+					t.Fatalf("extensions %04x, Chrome sends %04x", got.extensionIDs, want.extensionIDs)
+				}
+				gotIDs, wantIDs := sortedIDs(got.extensionIDs), sortedIDs(want.extensionIDs)
+				if !equalUint16s(gotIDs, wantIDs) {
+					t.Fatalf("extension set %04x, Chrome sends %04x", gotIDs, wantIDs)
+				}
+
+				for _, id := range wantIDs {
+					g, w := got.extensions[id], want.extensions[id]
+					switch id {
+					case 0x0a0a: // two GREASE extensions with different bodies
+						continue
+					case extSupportedGroups, extSigAlgs:
+						g, w = ungrease(g, 2), ungrease(w, 2)
+					case extSupportedVers:
+						g, w = ungrease(g, 1), ungrease(w, 1)
+					case extKeyShare:
+						if gs, ws := keyShareShape(t, g), keyShareShape(t, w); strings.Join(gs, ",") != strings.Join(ws, ",") {
+							t.Fatalf("key shares %v, Chrome sends %v", gs, ws)
+						}
+						continue
+					case extECH:
+						// GREASE ECH: random key and payload; BoringSSL picks the
+						// payload from 144/176/208/240 bytes, the capture has 176.
+						if d := len(g) - len(w); d != -32 && d != 0 && d != 32 && d != 64 {
+							t.Fatalf("GREASE ECH is %d bytes, Chrome sends %d (+-32n)", len(g), len(w))
+						}
+						if !bytes.Equal(g[:5], w[:5]) { // type, KDF, AEAD; the config id after them is random
+							t.Fatalf("GREASE ECH header %x, Chrome sends %x", g[:5], w[:5])
+						}
+						continue
+					}
+					if !bytes.Equal(g, w) {
+						t.Fatalf("extension %04x = %x, Chrome sends %x", id, g, w)
+					}
+				}
+
+				// signature_algorithms starts with a GREASE value: utls (v1.8.8, v1.9.0-alpha.1)
+				// does not fill it in, chrome155Spec does.
+				if sig := got.extensions[extSigAlgs]; !isGREASE(binary.BigEndian.Uint16(sig[2:])) {
+					t.Fatalf("signature_algorithms starts with %x, want GREASE", sig[2:4])
+				}
+
+				// Same size as the browser's hello, up to the GREASE ECH payload.
+				if d := len(raw) - (len(record) - 5); d != -32 && d != 0 && d != 32 && d != 64 {
+					t.Fatalf("ClientHello is %d bytes, Chrome sends %d (+-32n)", len(raw), len(record)-5)
+				}
+			}
+		})
+	}
+}
+
+// "chrome" keeps mihomo's meaning (Chrome 133): the patch only adds names.
+func TestChromeStaysVanilla(t *testing.T) {
+	for _, name := range []string{"chrome", "chrome133", "hellochrome_133", "hellochrome_auto"} {
+		id, ok := GetFingerprint(name)
+		if !ok || id == HelloChrome155 {
+			t.Fatalf("%s = %v, %v", name, id, ok)
+		}
+		hello := parseClientHello(t, buildRawClientHello(t, name, "www.example.com"))
+		if _, ok := hello.extensions[extensionTrustAnchors]; ok {
+			t.Fatalf("%s sends trust_anchors: it must stay the Chrome 133 hello", name)
+		}
+	}
+	if id, _ := GetFingerprint("chrome"); id != utls.HelloChrome_Auto {
+		t.Fatalf("chrome = %v, want utls.HelloChrome_Auto", id)
+	}
+	if id, _ := GetFingerprint("chrome133"); id != utls.HelloChrome_133 {
+		t.Fatalf("chrome133 = %v", id)
+	}
+}
+
+// A config with a ClientSessionCache that holds a TLS 1.3 session: utls panics
+// while building a HelloCustom hello without a pre_shared_key extension in the
+// spec, unless resumption may be skipped.
+func TestChrome155WithSessionCache(t *testing.T) {
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	template := &x509.Certificate{SerialNumber: big.NewInt(1), DNSNames: []string{"example.com"}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour)}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	go func() {
+		conn, err := ln.Accept()
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		server := tls.Server(conn, &tls.Config{Certificates: []tls.Certificate{{Certificate: [][]byte{der}, PrivateKey: key}}})
+		if server.Handshake() == nil {
+			_, _ = server.Write([]byte{1})
+			_, _ = io.Copy(io.Discard, server)
+		}
+	}()
+
+	cache := utls.NewLRUClientSessionCache(1)
+	config := &utls.Config{ServerName: "example.com", InsecureSkipVerify: true, ClientSessionCache: cache}
+	conn, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = conn.SetDeadline(time.Now().Add(5 * time.Second))
+	first := UClient(conn, config, HelloChrome155)
+	if err := first.Handshake(); err != nil {
+		t.Fatalf("first handshake: %v", err)
+	}
+	if _, err := io.ReadFull(first, make([]byte, 1)); err != nil { // processes the session ticket
+		t.Fatalf("read: %v", err)
+	}
+	_ = first.Close()
+	if _, ok := cache.Get("example.com"); !ok {
+		t.Fatal("no TLS 1.3 session in the cache after the first connection")
+	}
+
+	client, server := net.Pipe()
+	defer client.Close()
+	defer server.Close()
+	func() {
+		defer func() {
+			if r := recover(); r != nil {
+				t.Fatalf("BuildHandshakeState with a cached session panicked: %v", r)
+			}
+		}()
+		uConn := UClient(client, config, HelloChrome155)
+		if err := uConn.BuildHandshakeState(); err != nil {
+			t.Fatalf("BuildHandshakeState with a cached session: %v", err)
+		}
+		if _, ok := parseClientHello(t, uConn.HandshakeState.Hello.Raw).extensions[extensionTrustAnchors]; !ok {
+			t.Fatal("hello with a session cache is not Chrome 155")
+		}
+	}()
+	if config.PreferSkipResumptionOnNilExtension {
+		t.Fatal("UClient changed the caller's config")
+	}
+}
+
+// captureRealityHello runs GetRealityConn over a pipe and returns the
+// ClientHello it sent; the server side closes right after reading it.
+func captureRealityHello(t *testing.T, fingerprint UClientHelloID, config *RealityConfig) *utls.PubClientHelloMsg {
+	t.Helper()
+	client, server := net.Pipe()
+	defer client.Close()
+	defer server.Close()
+	deadline := time.Now().Add(5 * time.Second)
+	_ = client.SetDeadline(deadline)
+	_ = server.SetDeadline(deadline)
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		_, _ = GetRealityConn(context.Background(), client, fingerprint, "www.example.com", config)
+	}()
+	header := make([]byte, 5)
+	if _, err := io.ReadFull(server, header); err != nil {
+		t.Fatalf("read ClientHello header: %v", err)
+	}
+	body := make([]byte, int(binary.BigEndian.Uint16(header[3:5])))
+	if _, err := io.ReadFull(server, body); err != nil {
+		t.Fatalf("read ClientHello: %v", err)
+	}
+	_ = server.Close()
+	<-done
+	hello := utls.UnmarshalClientHello(body)
+	if hello == nil {
+		t.Fatal("captured record is not a ClientHello")
+	}
+	return hello
+}
+
+// chrome155 through REALITY: with the hybrid share it passes the XTLS/REALITY
+// key-share gate as itself (no swap), without it it is still Chrome 155 minus
+// the hybrid share.
+func TestChrome155Reality(t *testing.T) {
+	key, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer SetRealityMLKEMPolicy(RealityMLKEMAuto)
+	for _, policy := range []RealityMLKEMPolicy{RealityMLKEMOn, RealityMLKEMOff} {
+		SetRealityMLKEMPolicy(policy)
+		hello := captureRealityHello(t, HelloChrome155, &RealityConfig{PublicKey: key.PublicKey()})
+		if _, ok := parseClientHello(t, hello.Raw).extensions[extensionTrustAnchors]; !ok {
+			t.Fatalf("policy %d: REALITY hello is not Chrome 155", policy)
+		}
+		_, ok := xrayAcceptsKeyShares(hello.KeyShares)
+		if want := policy == RealityMLKEMOn; ok != want {
+			t.Fatalf("policy %d: Xray 26.9.8+ key-share gate = %v, want %v (shares %v)", policy, ok, want, hello.KeyShares)
+		}
+		if len(hello.SessionId) != 32 {
+			t.Fatalf("policy %d: session id %d bytes", policy, len(hello.SessionId))
+		}
+	}
+}
