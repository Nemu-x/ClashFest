@@ -0,0 +1,108 @@
+package tls
+
+// ClashFest core patch 0031 tests, adapted from Rerowros/veles
+// component/tls/reality_veles_test.go (GPL-3.0).
+
+import (
+	"crypto/ecdh"
+	"crypto/rand"
+	"testing"
+)
+
+func TestFingerprintSupportsX25519MLKEM768(t *testing.T) {
+	for name, want := range map[string]bool{
+		"chrome":     true,
+		"chrome133":  true,
+		"chrome155":  true,
+		"firefox":    true,
+		"safari":     true,
+		"chrome120":  false,
+		"firefox120": false,
+		"safari16":   false,
+		"edge":       false,
+	} {
+		id, ok := GetFingerprint(name)
+		if !ok {
+			t.Fatalf("fingerprint %q not found", name)
+		}
+		if got := FingerprintSupportsX25519MLKEM768(id); got != want {
+			t.Errorf("%s: X25519MLKEM768 key share = %v, want %v", name, got, want)
+		}
+	}
+}
+
+// sameHelloShape reports whether two ClientHellos come from the same parrot:
+// the same cipher suites in the same order and the same extension set, GREASE
+// values aside (chrome shuffles its extensions).
+func sameHelloShape(t *testing.T, a, b []byte) bool {
+	t.Helper()
+	pa, pb := parseClientHello(t, a), parseClientHello(t, b)
+	return equalUint16s(ungreaseSuites(pa.cipherSuites), ungreaseSuites(pb.cipherSuites)) &&
+		equalUint16s(sortedIDs(pa.extensionIDs), sortedIDs(pb.extensionIDs))
+}
+
+// The mlkem-client-fingerprint goes on the wire for a hybrid handshake (forced
+// by the proxy or by policy On), and the configured fingerprint for a classic
+// one (policy Off).
+func TestRealityMLKEMFingerprintReachesClientHello(t *testing.T) {
+	key, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	chrome, _ := GetFingerprint("chrome")
+	firefox, _ := GetFingerprint("firefox")
+	firefoxRaw := buildRawClientHello(t, "firefox", "www.example.com")
+	chromeRaw := buildRawClientHello(t, "chrome", "www.example.com")
+	if sameHelloShape(t, firefoxRaw, chromeRaw) {
+		t.Fatal("test cannot tell firefox from chrome")
+	}
+	defer SetRealityMLKEMPolicy(RealityMLKEMAuto)
+
+	cases := []struct {
+		name   string
+		policy RealityMLKEMPolicy
+		force  bool
+		want   []byte
+		hybrid bool
+	}{
+		{"forced", RealityMLKEMAuto, true, firefoxRaw, true},
+		{"policy on", RealityMLKEMOn, false, firefoxRaw, true},
+		{"policy off", RealityMLKEMOff, false, chromeRaw, false},
+	}
+	for _, c := range cases {
+		SetRealityMLKEMPolicy(c.policy)
+		hello := captureRealityHello(t, chrome, &RealityConfig{
+			PublicKey:             key.PublicKey(),
+			SupportX25519MLKEM768: c.force,
+			MLKEMFingerprint:      &firefox,
+		})
+		if !sameHelloShape(t, hello.Raw, c.want) {
+			t.Errorf("%s: REALITY hello is not the expected parrot", c.name)
+		}
+		if _, ok := xrayAcceptsKeyShares(hello.KeyShares); ok != c.hybrid {
+			t.Errorf("%s: Xray 26.9.8+ key-share gate = %v, want %v", c.name, ok, c.hybrid)
+		}
+	}
+}
+
+// Without mlkem-client-fingerprint nothing changes: a hybrid handshake with
+// chrome stays chrome, and one with firefox120 still takes 0023's Firefox hello.
+func TestRealityMLKEMFingerprintUnsetKeepsSeries(t *testing.T) {
+	key, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	chrome, _ := GetFingerprint("chrome")
+	hello := captureRealityHello(t, chrome, &RealityConfig{PublicKey: key.PublicKey(), SupportX25519MLKEM768: true})
+	if !sameHelloShape(t, hello.Raw, buildRawClientHello(t, "chrome", "www.example.com")) {
+		t.Error("chrome without mlkem-client-fingerprint changed its hello")
+	}
+	firefox120, _ := GetFingerprint("firefox120")
+	hello = captureRealityHello(t, firefox120, &RealityConfig{PublicKey: key.PublicKey(), SupportX25519MLKEM768: true})
+	if !sameHelloShape(t, hello.Raw, buildRawClientHello(t, "firefox", "www.example.com")) {
+		t.Error("firefox120 hybrid handshake is not the current Firefox hello")
+	}
+	if _, ok := xrayAcceptsKeyShares(hello.KeyShares); !ok {
+		t.Error("firefox120 hybrid handshake fails the Xray key-share gate")
+	}
+}
