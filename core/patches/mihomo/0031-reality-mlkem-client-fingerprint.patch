new file mode 100644
index 00000000..36382f1b
--- /dev/null
+++ b/component/tls/reality_mlkem_fingerprint.go
@@ -0,0 +1,30 @@
+package tls
+
+import (
+	utls "github.com/metacubex/utls"
+)
+
+// ClashFest core patch 0031: reality-opts.mlkem-client-fingerprint.
+// Adapted from Rerowros/veles (GPL-3.0), patch P7.
+
+// FingerprintSupportsX25519MLKEM768 reports whether the ClientHello of the
+// fingerprint carries the hybrid X25519MLKEM768 key share, which Xray 26.9.8+
+// requires in a REALITY handshake.
+func FingerprintSupportsX25519MLKEM768(id UClientHelloID) bool {
+	spec, err := fingerprintSpec(id)
+	if err != nil {
+		return false
+	}
+	for _, extension := range spec.Extensions {
+		keyShare, ok := extension.(*utls.KeyShareExtension)
+		if !ok {
+			continue
+		}
+		for _, share := range keyShare.KeyShares {
+			if share.Group == utls.X25519MLKEM768 {
+				return true
+			}
+		}
+	}
+	return false
+}
