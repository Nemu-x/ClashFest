+package outbound
+
+// ClashFest core patch 0031 tests, adapted from Rerowros/veles
+// adapter/outbound/reality_veles_test.go (GPL-3.0).
+
+import (
+	"crypto/ecdh"
+	"crypto/rand"
+	"encoding/base64"
+	"testing"
+
+	tlsC "github.com/metacubex/mihomo/component/tls"
+)
+
+func realityTestPublicKey(t *testing.T) string {
+	t.Helper()
+	privateKey, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return base64.RawURLEncoding.EncodeToString(privateKey.PublicKey().Bytes())
+}
+
+func TestRealityOptionsMLKEMClientFingerprint(t *testing.T) {
+	publicKey := realityTestPublicKey(t)
+
+	config, err := RealityOptions{PublicKey: publicKey}.Parse()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if config.MLKEMFingerprint != nil {
+		t.Fatal("unset mlkem-client-fingerprint set a fingerprint")
+	}
+
+	for _, name := range []string{"firefox", "Firefox", "safari", "chrome", "chrome155", "hellofirefox_148"} {
+		config, err = RealityOptions{PublicKey: publicKey, MLKEMClientFingerprint: name}.Parse()
+		if err != nil {
+			t.Fatalf("%s: %v", name, err)
+		}
+		want, _ := tlsC.GetFingerprint(name)
+		if config.MLKEMFingerprint == nil || *config.MLKEMFingerprint != want {
+			t.Fatalf("%s: mlkem-client-fingerprint = %v, want %v", name, config.MLKEMFingerprint, want)
+		}
+	}
+
+	for _, name := range []string{"no-such-browser", "none", "edge", "chrome120", "firefox120"} {
+		if _, err = (RealityOptions{PublicKey: publicKey, MLKEMClientFingerprint: name}).Parse(); err == nil {
+			t.Fatalf("mlkem-client-fingerprint %q accepted", name)
+		}
+	}
+
+	config, err = RealityOptions{PublicKey: publicKey, MLKEMClientFingerprint: "random"}.Parse()
+	if err != nil {
+		t.Fatalf("random: %v", err)
+	}
+	if config.MLKEMFingerprint == nil || !tlsC.FingerprintSupportsX25519MLKEM768(*config.MLKEMFingerprint) {
+		t.Fatalf("random gave %v without X25519MLKEM768", config.MLKEMFingerprint)
+	}
+}
+
+func TestRealityMLKEMFingerprintRandom(t *testing.T) {
+	edge, _ := tlsC.GetFingerprint("edge")
+	chrome, _ := tlsC.GetFingerprint("chrome")
+	firefox, _ := tlsC.GetFingerprint("firefox")
+
+	// "random" landed on a fingerprint without the share: chrome instead.
+	if got, err := realityMLKEMFingerprint("random", edge); err != nil || got != chrome {
+		t.Fatalf("random -> edge gave %v, %v; want chrome", got, err)
+	}
+	// "random" landed on one with the share: kept.
+	if got, err := realityMLKEMFingerprint("random", firefox); err != nil || got != firefox {
+		t.Fatalf("random -> firefox gave %v, %v", got, err)
+	}
+	// A named fingerprint without the share stays an error.
+	if _, err := realityMLKEMFingerprint("edge", edge); err == nil {
+		t.Fatal("named edge without X25519MLKEM768 accepted")
+	}
+}
