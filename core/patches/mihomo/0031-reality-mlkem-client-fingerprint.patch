+// realityMLKEMFingerprint checks the fingerprint picked for
+// mlkem-client-fingerprint. "random" is one pick per process and may land on a
+// fingerprint without the X25519MLKEM768 key share (ios): chrome is used then,
+// rather than failing the config on some starts. A named fingerprint without
+// the key share is a config error.
+func realityMLKEMFingerprint(name string, picked tlsC.UClientHelloID) (tlsC.UClientHelloID, error) {
+	if tlsC.FingerprintSupportsX25519MLKEM768(picked) {
+		return picked, nil
+	}
+	if strings.EqualFold(name, "random") {
+		if chrome, ok := tlsC.GetFingerprint("chrome"); ok && tlsC.FingerprintSupportsX25519MLKEM768(chrome) {
+			return chrome, nil
+		}
+	}
+	return tlsC.UClientHelloID{}, fmt.Errorf("REALITY mlkem-client-fingerprint %q has no X25519MLKEM768 key share", name)
+}
