@@ -0,0 +1,34 @@
+package provider
+
+import (
+	"testing"
+	"time"
+)
+
+func TestTimedCheckSkippedWhileSuspended(t *testing.T) {
+	hc := &HealthCheck{interval: time.Minute, lazy: false}
+	t.Cleanup(func() { SetHealthChecksSuspended(false) })
+
+	if !hc.shouldRunTimedCheck() {
+		t.Fatal("a non-lazy check must run when not suspended")
+	}
+	SetHealthChecksSuspended(true)
+	if hc.shouldRunTimedCheck() {
+		t.Fatal("a timed check ran while suspended")
+	}
+	SetHealthChecksSuspended(false)
+	if !hc.shouldRunTimedCheck() {
+		t.Fatal("timed checks did not resume")
+	}
+}
+
+func TestLazyCheckStillNeedsRecentTraffic(t *testing.T) {
+	hc := &HealthCheck{interval: time.Minute, lazy: true}
+	if hc.shouldRunTimedCheck() {
+		t.Fatal("a lazy check without traffic must be skipped")
+	}
+	hc.touch()
+	if !hc.shouldRunTimedCheck() {
+		t.Fatal("a lazy check after traffic must run")
+	}
+}
