+// healthChecksSuspended pauses the timed checks while the device screen is off.
+// Every provider and url-test group runs its own ticker, so on a config with many
+// subscriptions the timers alone kept waking the radio with the phone in a pocket.
+// On-demand checks (a tap, a network switch) still run; the timers resume on the
+// next tick after the screen comes back.
+var healthChecksSuspended stdatomic.Bool
+
+// SetHealthChecksSuspended is called by the Android bridge on screen off / on.
+func SetHealthChecksSuspended(suspended bool) {
+	healthChecksSuspended.Store(suspended)
+}
+
+// shouldRunTimedCheck reports whether a ticker fire should run the check.
+func (hc *HealthCheck) shouldRunTimedCheck() bool {
+	if healthChecksSuspended.Load() {
+		return false
+	}
+	return !hc.lazy || time.Since(hc.lastTouch.Load()) < hc.interval
+}
+
 func (hc *HealthCheck) process() {
 	ticker := time.NewTicker(hc.interval)
 	go hc.check()
 	for {
 		select {
 		case <-ticker.C:
-			lastTouch := hc.lastTouch.Load()
-			since := time.Since(lastTouch)
-			if !hc.lazy || since < hc.interval {
+			if hc.shouldRunTimedCheck() {
 				hc.check()
 			} else {
-				log.Debugln("Skip once health check because we are lazy")
+				log.Debugln("Skip once health check: lazy or suspended")
 			}
 		case <-hc.ctx.Done():
 			ticker.Stop()
