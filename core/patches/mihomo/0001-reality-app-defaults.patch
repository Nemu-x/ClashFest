diff --git a/adapter/outbound/reality_defaults_test.go b/adapter/outbound/reality_defaults_test.go
new file mode 100644
index 00000000..ac5fadf9
--- /dev/null
+++ b/adapter/outbound/reality_defaults_test.go
@@ -0,0 +1,54 @@
+package outbound
+
+import (
+	"crypto/ecdh"
+	"crypto/rand"
+	"encoding/base64"
+	"testing"
+
+	tlsC "github.com/metacubex/mihomo/component/tls"
+)
+
+func testRealityPublicKey(t *testing.T) string {
+	t.Helper()
+	key, err := ecdh.X25519().GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return base64.RawURLEncoding.EncodeToString(key.PublicKey().Bytes())
+}
+
+func TestRealityAppDefaultsApplyOnlyWhereTheProxyIsSilent(t *testing.T) {
+	t.Cleanup(func() {
+		tlsC.RealityClientVersionOverride = ""
+		tlsC.RealityDisableX25519MLKEM768ByDefault = false
+	})
+	key := testRealityPublicKey(t)
+
+	cfg, err := RealityOptions{PublicKey: key}.Parse()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.DisableX25519MLKEM768 || cfg.ClientVersion != [3]byte{26, 10, 10} {
+		t.Fatalf("stock defaults changed: %+v", cfg)
+	}
+
+	tlsC.RealityClientVersionOverride = "25.1.1"
+	tlsC.RealityDisableX25519MLKEM768ByDefault = true
+	cfg, err = RealityOptions{PublicKey: key}.Parse()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !cfg.DisableX25519MLKEM768 || cfg.ClientVersion != [3]byte{25, 1, 1} {
+		t.Fatalf("app defaults not applied: %+v", cfg)
+	}
+
+	on := true
+	cfg, err = RealityOptions{PublicKey: key, ClientVersion: "26.4.13", SupportX25519MLKEM768: &on}.Parse()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.DisableX25519MLKEM768 || cfg.ClientVersion != [3]byte{26, 4, 13} {
+		t.Fatalf("proxy settings must win over app defaults: %+v", cfg)
+	}
+}
