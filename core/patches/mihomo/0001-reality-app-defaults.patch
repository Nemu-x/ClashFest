+	// RealityDefaultClientVersion by proxies that set no client-version.
+	RealityClientVersionOverride string
+	// RealityDisableX25519MLKEM768ByDefault drops the hybrid key share for proxies that do not
+	// set support-x25519mlkem768, for users whose servers predate it.
+	RealityDisableX25519MLKEM768ByDefault bool
+)
