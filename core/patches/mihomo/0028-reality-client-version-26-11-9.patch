index 68850fee..d74440e2 100644
--- a/component/tls/reality.go
+++ b/component/tls/reality.go
@@ -32,8 +32,10 @@ const RealityMaxShortIDLen = 8
 // RealityClientVersion is the Xray-style client version carried in the first
