@@ -0,0 +1,48 @@
+package xdrive
+
+import (
+	"context"
+	"encoding/pem"
+	"net"
+	stdhttp "net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/metacubex/mihomo/component/ca"
+)
+
+// The default storage client verifies against the pool of component/ca: a
+// root added there (tls.custom-certifactes) is trusted, and without it the
+// same server is refused. Citrus d3a24184.
+func TestHTTPClientUsesCAPool(t *testing.T) {
+	srv := httptest.NewTLSServer(stdhttp.HandlerFunc(func(w stdhttp.ResponseWriter, r *stdhttp.Request) {
+		w.WriteHeader(stdhttp.StatusNoContent)
+	}))
+	defer srv.Close()
+	ca.ResetCertificate()
+	t.Cleanup(ca.ResetCertificate)
+
+	dial := func(ctx context.Context, network, _ string) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(ctx, network, srv.Listener.Addr().String())
+	}
+	// httptest's certificate is issued for example.com.
+	const url = "https://example.com/"
+
+	if resp, err := NewHTTPClient(dial, nil).Get(url); err == nil {
+		_ = resp.Body.Close()
+		t.Fatal("a server whose root is not in the pool was trusted")
+	}
+
+	root := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: srv.Certificate().Raw})
+	if err := ca.AddCertificate(string(root)); err != nil {
+		t.Fatal(err)
+	}
+	resp, err := NewHTTPClient(dial, nil).Get(url)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = resp.Body.Close()
+	if resp.StatusCode != stdhttp.StatusNoContent {
+		t.Fatalf("status %d", resp.StatusCode)
+	}
+}
