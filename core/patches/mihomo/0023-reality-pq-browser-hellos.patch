diff --git a/component/tls/reality_pq_specs.go b/component/tls/reality_pq_specs.go
new file mode 100644
index 0000000..ab9d2b7
--- /dev/null
+++ b/component/tls/reality_pq_specs.go
@@ -0,0 +1,46 @@
+package tls
+
+import (
+	"net"
+
+	utls "github.com/metacubex/utls"
+)
+
+// Current-browser ClientHellos for the REALITY handshakes that need the
+// X25519MLKEM768 key share (Xray 26.9.8+ forwards a hello without it to the
+// cover site). Since metacubex/utls v1.9.0-alpha.1 (mihomo v1.19.34) "firefox"
+// is Firefox 148 and "safari" is Safari 26.3, and both carry that share
+// themselves. A proxy pinned to an older parrot of those families (firefox120,
+// hellofirefox_105, safari16, ...) has none; for such a handshake it switches
+// to its family's current hello instead of borrowing chrome's, so the browser
+// family the user chose is kept.
+//
+// Until v1.19.34 this file carried the two parrots as ClientHelloSpec data
+// (from metacubex/utls branch v1.9.0-mod-meta a6a364a, identical to the
+// released ones, Firefox's X25519 share reusing the hybrid key included).
+
+type realityPQHello struct {
+	name string
+	id   utls.ClientHelloID
+}
+
+// realityPQHelloFor returns the post-quantum hello for a fingerprint family
+// whose current utls parrot offers X25519MLKEM768, or false when there is none.
+func realityPQHelloFor(fingerprint UClientHelloID) (realityPQHello, bool) {
+	switch fingerprint.Client {
+	case utls.HelloFirefox_Auto.Client:
+		return realityPQHello{name: "Firefox 148", id: utls.HelloFirefox_148}, true
+	case utls.HelloSafari_Auto.Client:
+		return realityPQHello{name: "Safari 26.3", id: utls.HelloSafari_26_3}, true
+	}
+	return realityPQHello{}, false
+}
+
+// realityPQConn builds the handshake state from a post-quantum hello.
+func realityPQConn(conn net.Conn, config *utls.Config, hello realityPQHello) (*utls.UConn, error) {
+	uConn := utls.UClient(conn, config, hello.id)
+	if err := uConn.BuildHandshakeState(); err != nil {
+		return nil, err
+	}
+	return uConn, nil
+}
diff --git a/component/tls/reality_pq_specs_test.go b/component/tls/reality_pq_specs_test.go
new file mode 100644
index 0000000..f232f5d
--- /dev/null
+++ b/component/tls/reality_pq_specs_test.go
@@ -0,0 +1,155 @@
+package tls
+
+import (
+	"bytes"
+	"net"
+	"testing"
+
+	utls "github.com/metacubex/utls"
+)
+
+// xrayAcceptsKeyShares mirrors the key-share gate of XTLS/REALITY 8cdf7bf
+// (Xray 26.9.8+): exactly one X25519MLKEM768 share, an optional X25519 share
+// only after it, and the X25519 key the server will use for the auth key.
+func xrayAcceptsKeyShares(shares []utls.KeyShare) (x25519 []byte, ok bool) {
+	var peerPub, peerPub2 []byte
+	for _, ks := range shares {
+		if ks.Group == utls.X25519MLKEM768 && len(ks.Data) == 1184+32 {
+			if peerPub2 != nil {
+				return nil, false
+			}
+			peerPub2 = ks.Data[1184:]
+			continue
+		}
+		if ks.Group == utls.X25519 && len(ks.Data) == 32 {
+			if peerPub != nil {
+				return nil, false
+			}
+			peerPub = ks.Data
+			break
+		}
+	}
+	if peerPub2 == nil {
+		return nil, false
+	}
+	if peerPub == nil {
+		peerPub = peerPub2
+	}
+	return peerPub, true
+}
+
+func buildPQ(t *testing.T, fp UClientHelloID) *utls.UConn {
+	t.Helper()
+	hello, ok := realityPQHelloFor(fp)
+	if !ok {
+		t.Fatalf("%s: no post-quantum hello", fp.Client)
+	}
+	c1, c2 := net.Pipe()
+	t.Cleanup(func() { c1.Close(); c2.Close() })
+	uConn, err := realityPQConn(c1, &utls.Config{ServerName: "www.example.com", InsecureSkipVerify: true}, hello)
+	if err != nil {
+		t.Fatalf("%s: %v", hello.name, err)
+	}
+	return uConn
+}
+
+func TestRealityPQHelloPassesXrayGate(t *testing.T) {
+	for _, fp := range []UClientHelloID{utls.HelloFirefox_Auto, utls.HelloSafari_Auto} {
+		uConn := buildPQ(t, fp)
+		keys := uConn.HandshakeState.State13.KeyShareKeys
+		if keys == nil || keys.Mlkem == nil || keys.MlkemEcdhe == nil || keys.Ecdhe == nil {
+			t.Fatalf("%s: incomplete private keys %+v", fp.Client, keys)
+		}
+		x25519, ok := xrayAcceptsKeyShares(uConn.HandshakeState.Hello.KeyShares)
+		if !ok {
+			t.Fatalf("%s: hello would be forwarded to the cover site by Xray 26.9.8+", fp.Client)
+		}
+		// The REALITY auth key is computed from State13 Ecdhe on our side and
+		// from this share on the server's: they must be the same key.
+		if !bytes.Equal(x25519, keys.Ecdhe.PublicKey().Bytes()) {
+			t.Fatalf("%s: server-side X25519 share does not match the client's auth key", fp.Client)
+		}
+		if !realityHasMLKEMShare(uConn) {
+			t.Fatalf("%s: realityHasMLKEMShare = false", fp.Client)
+		}
+	}
+}
+
+func TestRealityPQFirefoxReusesX25519(t *testing.T) {
+	uConn := buildPQ(t, utls.HelloFirefox_Auto)
+	var hybrid, classic []byte
+	for _, ks := range uConn.HandshakeState.Hello.KeyShares {
+		switch ks.Group {
+		case utls.X25519MLKEM768:
+			hybrid = ks.Data
+		case utls.X25519:
+			classic = ks.Data
+		}
+	}
+	if len(hybrid) != 1184+32 || len(classic) != 32 || !bytes.Equal(hybrid[1184:], classic) {
+		t.Fatalf("Firefox sends one X25519 key in both shares; got hybrid %d bytes, classic %d bytes", len(hybrid), len(classic))
+	}
+	keys := uConn.HandshakeState.State13.KeyShareKeys
+	if keys.Ecdhe != keys.MlkemEcdhe {
+		t.Fatal("classical private key must be the hybrid one")
+	}
+}
+
+func TestRealityPQSafariKeepsSeparateKeys(t *testing.T) {
+	uConn := buildPQ(t, utls.HelloSafari_Auto)
+	var hybrid, classic []byte
+	for _, ks := range uConn.HandshakeState.Hello.KeyShares {
+		switch ks.Group {
+		case utls.X25519MLKEM768:
+			hybrid = ks.Data
+		case utls.X25519:
+			classic = ks.Data
+		}
+	}
+	if len(classic) != 32 || bytes.Equal(hybrid[1184:], classic) {
+		t.Fatal("Safari 26.3 keeps a separate X25519 key")
+	}
+}
+
+func TestRealityPQSpecsAreFreshPerHandshake(t *testing.T) {
+	a, b := buildPQ(t, utls.HelloFirefox_Auto), buildPQ(t, utls.HelloFirefox_Auto)
+	if bytes.Equal(a.HandshakeState.Hello.Raw, b.HandshakeState.Hello.Raw) {
+		t.Fatal("two handshakes produced the same hello")
+	}
+}
+
+func TestRealityPQHelloFromOldParrot(t *testing.T) {
+	// A pinned pre-quantum parrot of the family has no hybrid share; the hello it
+	// switches to does (and is the one "firefox" / "safari" send themselves).
+	for _, c := range []struct{ old, current UClientHelloID }{
+		{utls.HelloFirefox_120, utls.HelloFirefox_Auto},
+		{utls.HelloFirefox_105, utls.HelloFirefox_Auto},
+		{utls.HelloSafari_16_0, utls.HelloSafari_Auto},
+	} {
+		c1, c2 := net.Pipe()
+		old := utls.UClient(c1, &utls.Config{ServerName: "www.example.com", InsecureSkipVerify: true}, c.old)
+		if err := old.BuildHandshakeState(); err != nil {
+			t.Fatalf("%s/%s: %v", c.old.Client, c.old.Version, err)
+		}
+		c1.Close()
+		c2.Close()
+		if realityHasMLKEMShare(old) {
+			t.Fatalf("%s/%s already offers X25519MLKEM768", c.old.Client, c.old.Version)
+		}
+		hello, ok := realityPQHelloFor(c.old)
+		if !ok || hello.id != c.current {
+			t.Fatalf("%s/%s: post-quantum hello %+v, want %s/%s", c.old.Client, c.old.Version, hello.id, c.current.Client, c.current.Version)
+		}
+		if !realityHasMLKEMShare(buildPQ(t, c.old)) {
+			t.Fatalf("%s/%s: switched hello has no X25519MLKEM768 share", c.old.Client, c.old.Version)
+		}
+	}
+}
+
+func TestRealityPQHelloOnlyForOldParrots(t *testing.T) {
+	for _, fp := range []UClientHelloID{utls.HelloChrome_Auto, utls.HelloIOS_Auto, utls.HelloEdge_Auto, utls.HelloRandomized} {
+		if _, ok := realityPQHelloFor(fp); ok {
+			t.Errorf("%s must not get a post-quantum hello", fp.Client)
+		}
+	}
+}
