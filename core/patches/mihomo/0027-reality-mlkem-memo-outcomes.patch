+// ClashFest core patch 0027: only a handshake the server answered says
+// something about the key share. Xray of either generation does not fail a
+// hello it does not accept: it hands it to its cover site, whose certificate
+// then fails REALITY authentication (refused). A connection that ends before
+// any answer, or on a timeout, EOF, closed socket or cancelled context, is
+// silent: the network's doing, or a server that cannot reach its cover site.
+// Silence neither flips nor unpins a verdict; after realityMemoFlipAfter silent
+// handshakes in a row the next attempt probes the other key share once (its
+// success pins it, its failure is a stale attempt and changes nothing), which
+// still finds a server that drops the wrong hello instead of relaying it.
+// The classification is adapted from Rerowros/veles (GPL-3.0), which itself
+// adapted this memo from ClashFest core patch 0002.
+type realityOutcome int
+
+const (
+	realityOutcomeNone    realityOutcome = iota // nothing to learn (authenticated, then failed)
+	realityOutcomeOK                            // authenticated handshake
+	realityOutcomeRefused                       // the server answered and did not let us in
+	realityOutcomeSilent                        // the network failed before an answer
+)
+
+// realityClassify maps the result of HandshakeContext to a memo outcome: err is
+// the handshake error, ctxErr the context error after it, serverHelloSeen
+// whether a ServerHello arrived, verified whether REALITY authentication passed.
+// The checks run in order; the first match wins.
+func realityClassify(err error, ctxErr error, serverHelloSeen bool, verified bool) realityOutcome {
+	switch {
+	case err == nil && verified:
+		return realityOutcomeOK
+	case err != nil && verified:
+		return realityOutcomeNone
+	case err != nil && realityNetworkFailure(err, ctxErr):
+		// Even after a ServerHello: a cut or stalled connection is not an
+		// answer about the key share.
+		return realityOutcomeSilent
+	case err != nil && !serverHelloSeen:
+		return realityOutcomeSilent
+	default:
+		// err == nil && !verified: the cover site's real certificate;
+		// err != nil after a ServerHello: x509, bad certificate, an alert.
+		return realityOutcomeRefused
+	}
+}
+
+// realityNetworkFailure reports a cancelled or timed-out context, a timeout,
+// EOF or a closed connection. It deliberately does not accept every
+// *net.OpError: utls wraps a remote alert from the server in one as well.
+func realityNetworkFailure(err error, ctxErr error) bool {
+	if ctxErr != nil ||
+		errors.Is(err, context.Canceled) ||
+		errors.Is(err, context.DeadlineExceeded) ||
+		errors.Is(err, os.ErrDeadlineExceeded) ||
+		errors.Is(err, io.EOF) ||
+		errors.Is(err, io.ErrUnexpectedEOF) ||
+		errors.Is(err, net.ErrClosed) {
+		return true
+	}
+	var netErr net.Error
+	return errors.As(err, &netErr) && netErr.Timeout()
+}
