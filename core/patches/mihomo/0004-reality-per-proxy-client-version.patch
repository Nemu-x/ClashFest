diff --git a/component/tls/reality_client_version.go b/component/tls/reality_client_version.go
new file mode 100644
index 00000000..0971c092
--- /dev/null
+++ b/component/tls/reality_client_version.go
@@ -0,0 +1,45 @@
+package tls
+
+// ClashFest core patch 0004: per-proxy REALITY client version.
+//
+// Patch 0001 made the client version in the REALITY session id a process-wide
+// setting (RealityClientVersion, pushed from the app settings). A single
+// subscription can mix Xray servers with different minClientVer / maxClientVer
+// bounds, so reality-opts.client-version lets one proxy report its own
+// version. Empty keeps the global value, which is read at handshake time, so a
+// later SetRealityPolicy from the app still applies to every other proxy.
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// ParseRealityClientVersion parses an Xray-style "x.y.z" version into the
+// three session id bytes. Exactly three parts, each 0..255; anything else is
+// an error so a typo in a subscription fails config validation instead of
+// silently reporting 0.0.0.
+func ParseRealityClientVersion(version string) ([3]byte, error) {
+	var out [3]byte
+	parts := strings.Split(strings.TrimSpace(version), ".")
+	if len(parts) != len(out) {
+		return out, fmt.Errorf("invalid REALITY client version %q: want x.y.z", version)
+	}
+	for i, part := range parts {
+		n, err := strconv.ParseUint(part, 10, 8)
+		if err != nil {
+			return [3]byte{}, fmt.Errorf("invalid REALITY client version %q: want x.y.z with parts 0..255", version)
+		}
+		out[i] = byte(n)
+	}
+	return out, nil
+}
+
+// EffectiveClientVersion is the version this proxy reports: its own
+// client-version when set, otherwise the global RealityClientVersion.
+func (c *RealityConfig) EffectiveClientVersion() [3]byte {
+	if c != nil && c.ClientVersion != nil {
+		return *c.ClientVersion
+	}
+	return RealityClientVersion
+}
