+package outbound
+
+import "testing"
+
+// ClashFest core patch 0004: reality-opts.client-version.
+func TestRealityOptionsClientVersion(t *testing.T) {
+	base := RealityOptions{PublicKey: "SuEmqx2lN3HPJCv0YBhmTc-B4MIlGiEfxv-gYTdkbAQ", ShortID: "a1"}
+
+	cfg, err := base.Parse()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.ClientVersion != nil {
+		t.Fatalf("empty client-version must keep the global version, got %v", *cfg.ClientVersion)
+	}
+
+	withVersion := base
+	withVersion.ClientVersion = "26.9.9"
+	cfg, err = withVersion.Parse()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.ClientVersion == nil || *cfg.ClientVersion != [3]byte{26, 9, 9} {
+		t.Fatalf("client-version not parsed: %v", cfg.ClientVersion)
+	}
+
+	for _, bad := range []string{"26.9", "26.9.x", "300.1.1", "26.9.9.9"} {
+		o := base
+		o.ClientVersion = bad
+		if _, err := o.Parse(); err == nil {
+			t.Errorf("client-version %q accepted", bad)
+		}
+	}
+}
